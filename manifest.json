{
  "manifest_version": 3,
  "name": "Atelier",
  "version": "0.1.0",
  "description": "Named workspaces in one browser window. Switching moves tabs instead of closing them, so nothing reloads.",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Workspaces",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Open the workspaces tab"
    },
    "workspace-1": {
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "MacCtrl+1"
      },
      "description": "Switch to workspace 1"
    },
    "workspace-2": {
      "suggested_key": {
        "default": "Ctrl+Shift+2",
        "mac": "MacCtrl+2"
      },
      "description": "Switch to workspace 2"
    },
    "workspace-3": {
      "suggested_key": {
        "default": "Ctrl+Shift+3",
        "mac": "MacCtrl+3"
      },
      "description": "Switch to workspace 3"
    },
    "workspace-4": {
      "description": "Switch to workspace 4"
    },
    "workspace-5": {
      "description": "Switch to workspace 5"
    },
    "workspace-6": {
      "description": "Switch to workspace 6"
    },
    "workspace-7": {
      "description": "Switch to workspace 7"
    },
    "workspace-8": {
      "description": "Switch to workspace 8"
    },
    "workspace-9": {
      "description": "Switch to workspace 9"
    },
    "previous-workspace": {
      "description": "Switch back to the previous workspace"
    }
  }
}